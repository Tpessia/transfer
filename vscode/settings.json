{
    "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript][javascriptreact][typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json][jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[css][scss][less]": {
        "editor.defaultFormatter": "vscode.css-language-features"
    },
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "explorer.compactFolders": false,
    "extensions.ignoreRecommendations": true,
    "security.workspace.trust.enabled": false,
    "editor.hover.delay": 1000,
    "editor.hover.sticky": true,
    "typescript.preferences.importModuleSpecifier": "non-relative",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "typescript.preferences.quoteStyle": "single",
    "files.refactoring.autoSave": false,
    "editor.indentSize": "tabSize",
    "editor.tabSize": 2,
    "terminal.integrated.automationProfile.windows": {},
    "debug.javascript.autoAttachFilter": "disabled",
    "workbench.editor.empty.hint": "hidden",
    "git.enableSmartCommit": true,
    "explorer.confirmPasteNative": false,
    "codeium.enableCodeLens": false,
    "diffEditor.maxComputationTime": 0,
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "chat.editing.alwaysSaveWithGeneratedChanges": true,
    "redhat.telemetry.enabled": false,
    "yaml.schemas": {
        "file:///home/pessia/.vscode/extensions/atlassian.atlascode-3.8.2/resources/schemas/pipelines-schema.json": "bitbucket-pipelines.yml"
    },
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.nextEditSuggestions.fixes": false
}


{
    "workbench.editor.empty.hint": "hidden",
    "workbench.startupEditor": "none",
    "terminal.integrated.initialHint": false,
    "files.hotExit": "onExitAndWindowClose",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.hideOnboarding": true,
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.initialPermissionMode": "bypassPermissions",
    "chat.byokUtilityModelDefault": "mainAgent",
    "chat.mcp.discovery.enabled": {
        "claude-desktop": true
    },
    "git.repositoryScanMaxDepth": 3,
    "issueReporter.wizard.fullWorkspaceScan": false,
    "git.autoRepositoryDetection": "subFolders",
    "git.repositoryScanIgnoredFolders": [
        "node_modules",
        "repos-tmp"
    ],
    "chat.viewSessions.orientation": "stacked",
    "chat.mcp.gallery.enabled": true,
    "chat.agent.sandbox.enabled": "on",
    "chat.permissions.default": "autoApprove",
    "chat.defaultConfiguration": {
        "mode": "interactive",
        "approvals": "allowAll"
    },
    // "chat.defaultModel": "claude-opus-5-5",
    "chat.defaultToCopilotHarness": false,
    "chat.editor.preferCopilotHarness": false,
    "chat.newSession.defaultMode": "Infra",
    "chat.requestQueuing.defaultAction": "queue",
    "chat.agent.maxRequests": 100,
    "chat.implicitContext.suggestedContext": true,
    "chat.implicitContext.enabled": {
        "panel": "never"
    },
    "security.workspace.trust.untrustedFiles": "open"
}